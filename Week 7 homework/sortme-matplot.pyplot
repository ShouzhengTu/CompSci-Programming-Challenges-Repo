#Imported libaries 
import os
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation
import numpy as np 


#Array Generation 
def sort_me():
    n = 100
    arr = np.arange(1,n+1)
    np.random.shuffle(arr)
    return arr


#Bubble sort algorithm with tracked arrayacesses and comparisons
def bubblesort(arr):
    
    arrayAcesses = [0] 
    comparisons = [0] 
    arrayAcess = 0 
    comparison = 0 
    snapshot = [arr.copy()]

    swapped = True
    while swapped == True:
        swapped = False 
        for i in range(len(arr)-1):
            arrayAcess += 2
            comparison += 1
            if arr[i] > arr[i+1]:
                t = arr[i]
                arr[i] = arr[i+1]
                arr[i+1] = t 
                arrayAcess += 4
                swapped = True

            snapshot.append(arr.copy())
            arrayAcesses.append(arrayAcess)
            comparisons.append(comparison)

    return snapshot,arrayAcesses,comparisons


#Selection sort algorithm with tracked arrayacesses and comparisons
def selection_sort(arr):
    
    arrayAcesses = [0] 
    comparisons = [0] 
    arrayAcess = 0 
    comparison = 0 
    snapshot = [arr.copy()]
    highestIndex = len(arr)-1
    insertIndex = 0 
    
    while insertIndex < highestIndex:
        minPosition = insertIndex 
        for i in range(insertIndex,highestIndex+1):
            arrayAcess += 2 
            comparison += 1
            if arr[i] < arr[minPosition]:
                minPosition = i
        c = arr[minPosition]
        arr[minPosition] = arr[insertIndex]
        arr[insertIndex] = c
        arrayAcess += 4
        
        arrayAcesses.append(arrayAcess)
        comparisons.append(comparison)
        snapshot.append(arr.copy())

        insertIndex = insertIndex + 1

    return snapshot,arrayAcesses,comparisons


#Quick sort algorithm with tracked arrayacesses and comparisons
def parition(arr, low, high,cA,cC):
    
    snapshot = []
    arrayAcesses = [] 
    comparisons = []
    arrayAcess = cA 
    comparison = cC

    pivot = arr[low]
    arrayAcess += 1
    i = low
    j = high

    while True:

        arrayAcess += 1 
        comparison += 1

        while arr[i] < pivot:
            i += 1
            arrayAcess += 1 
            comparison += 1
        
        arrayAcess += 1 
        comparison += 1

        while arr[j] > pivot:
            j -= 1 
            arrayAcess += 1 
            comparison += 1
        
        if i >= j:
            return j,snapshot,arrayAcesses,comparisons,arrayAcess,comparison
        
        c = arr[i]
        arr[i] = arr[j]
        arr[j] = c

        arrayAcess += 4 

        arrayAcesses.append(arrayAcess)
        comparisons.append(comparison)
        snapshot.append(arr.copy())
        


def quicksort(sort_me, low, high, arrayAcess=0, comparison=0):
    totalComparisons = []
    totalArrayAcesses = []
    total_snapshots = []

    if low < high:
        p,snapshot,arrayAcesses,comparsions,arrayAcess,comparison = parition(sort_me, low, high, arrayAcess,comparison)

        total_snapshots.extend(snapshot)
        totalArrayAcesses.extend(arrayAcesses)
        totalComparisons.extend(comparsions)

        left_snapshots, left_acesses,left_comparisons, arrayAcess, comparison = quicksort(sort_me, low, p, arrayAcess, comparison)

        total_snapshots.extend(left_snapshots)
        totalArrayAcesses.extend(left_acesses)
        totalComparisons.extend(left_comparisons)

        right_snapshots, right_acesses,right_comparisons, arrayAcess,comparison = quicksort(sort_me, p+1, high, arrayAcess,comparison)

        total_snapshots.extend(right_snapshots)
        totalArrayAcesses.extend(right_acesses)
        totalComparisons.extend(right_comparisons)

    return total_snapshots,totalArrayAcesses,totalComparisons, arrayAcess, comparison



#Choice & value interchange
def choices_value_interchange(choice,arr):
    if choice == 1:
        return (*bubblesort(arr), "bubble sort")
    elif choice == 2:
        return (*selection_sort(arr), "selection sort")
    elif choice == 3:
        package = quicksort(arr,0,len(arr)-1)
        package = package[:-2]
        return (*package, "quick sort")
    elif choice == 4:
        exit()


# UI & UX setup 
def alert(text):
    print(len(text)*"-")
    print(text)
    print(len(text)*"-")



def menu_ui():
    alert("📶Welcome to the Algorithm Visualiser📶")
    texts = [
        "1. Bubble Sort",
        "2. Selection Sort",
        "3. Quick Sort",
        "4. Exit"
        ]
    for text in texts:
        print(text+"\n")
    alert("Please select the algorithm you want to visualize")



def selection():
    choice = int(input())
    return choice



def proceed():
    alert(f"Proceed?")
    input()



def menu(arr):
    menu_ui()
    choice = selection()
    package = choices_value_interchange(choice,arr)
    return package


#Graph & Animations 
def graph(arr,name):
    fig, ax = plt.subplots(figsize=(20,10))
    bars = plt.bar(np.arange(0,len(arr)),arr, width=0.8)
    ax.set_title(f"VISUALIZING {name}")
    fig.suptitle("SORTING VISUALIZER", fontsize = 18)
    txt = ax.text(0,100,"")
    array = ax.text(30,100,"")
    comp = ax.text(60,100,"")
    
    return bars,fig,txt,array,comp 



def animations(snapshot,bars,fig,txt,array,comp,arrayAcesses,comparisons):

    fps = 360

    def update(frames):
        txt.set_text(f"FRAMES = {frames}")
        array.set_text(f"ARRAYACESSED = {arrayAcesses[frames]}")
        comp.set_text(f"COMPARISONS = {comparisons[frames]}")
        
        for bar,height in zip(bars,snapshot[frames]):
            bar.set_height(height)
        
        return (*bars,txt,array,comp)
        
    ani = FuncAnimation(
        fig,
        update,
        frames=range(len(snapshot)),
        interval=1000/fps,
        blit=True,
        repeat=False
    )

    plt.show()
    plt.close()



def main():
    while True:
        os.system("clear")
        arr = sort_me()
        snapshot,arrayAcesses,comparisons,name = menu(arr)
        bars,fig,txt,array,comp = graph(arr,name.upper())
        animations(snapshot,bars,fig,txt,array,comp,arrayAcesses,comparisons)



main()
